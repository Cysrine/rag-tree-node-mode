# Copy to .env and adjust. All vars are prefixed RAG_ (see rag_pipeline/config.py).

# --- Storage: Postgres + pgvector ---
# Host 5433 matches docker-compose (avoids clashing with a native Postgres on 5432).
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# --- Embeddings (pluggable) ---
# provider: bge | voyage | openai | dev
#   bge   -> local BAAI/bge-large-en-v1.5 (1024-dim), no API key (needs .[embed-local])
#   dev   -> deterministic, dependency-free vectors for tests/CI
RAG_EMBEDDING_PROVIDER=bge
RAG_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RAG_EMBEDDING_DIM=1024
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# --- Parsing ---
# strategy: auto | hi_res | fast | ocr_only | fallback
#   auto      -> scanned PDFs go to OCR, digital PDFs to hi_res, else fallback
#   fallback  -> pdfplumber only (no heavy deps)
RAG_PARSE_STRATEGY=auto
RAG_OCR_LANGUAGES=eng
RAG_HI_RES_MODEL=yolox
RAG_INFER_TABLE_STRUCTURE=true
# Below this average of extractable chars/page, a PDF is treated as scanned -> OCR.
RAG_MIN_CHARS_PER_PAGE_DIGITAL=100

# --- Chunking ---
# Kept under a typical 512-token embedder limit to leave room for the path prefix.
RAG_CHUNK_MAX_TOKENS=384
RAG_CHUNK_MIN_TOKENS=64
RAG_CHUNK_OVERLAP_TOKENS=0

# --- Generation (LLM) ---
RAG_LLM_PROVIDER=groq
RAG_LLM_MODEL=qwen/qwen3.8-27b
RAG_RETRIEVAL_TOP_K=8
# Name of the env var (below) that holds the API key — read at call time.
RAG_LLM_API_KEY_ENV=GROQ-KEY
GROQ-KEY=your-groq-api-key-here
